@page "/dayplanning"
@using Planning.Client.DayPlanning

<PageTitle>Dagplanning</PageTitle>

<header class="day-planning-header">
    <p>Dagplanning</p> @* TODO -> Goedemorgen, Nicolas .. Goedeavond, Nicolas*@
    <h1 data-testid="selected-date">
        @FormatSelectedDate(_selectedDate)
    </h1>
    
    <div class="day-navigation-slot">
        <DateNavigation SelectedDate="_selectedDate"
                        DateSelected="SelectDateAsync" />
        
        @if (!_isLoading && !_hasLoadError)
        {
            <a class="global-add-activity mobile-activity-action"
               data-testid="mobile-global-add-activity-link"
               href="@NewActivityUrl"
               aria-label="Activiteit toevoegen">
                <span class="global-add-icon" aria-hidden="true">+</span>
                <span class="global-add-label">Activiteit toevoegen</span>
            </a>
            <button type="button"
                    class="global-add-activity desktop-activity-action"
                    data-testid="global-add-activity-button"
                    @ref="_globalAddButton"
                    aria-label="Activiteit toevoegen"
                    @onclick="() => OpenActivityForm(null, _globalAddButton)">
                <span class="global-add-icon" aria-hidden="true">+</span>
                <span class="global-add-label">Activiteit toevoegen</span>
            </button>
        }
    </div>
    
    
</header>

@if (_isActivityDetailsLoading)
{
    <p role="status">Activiteit laden...</p>
}
else if (_activityDetailsError is not null)
{
    <p role="alert">@_activityDetailsError</p>
}

@if (_isLoading)
{
    <p>Dagplanning laden...</p>
}
else if (_hasLoadError)
{
    <p role="alert">De dagplanning kon niet geladen worden.</p>
}
else
{
    <div class="time-block-grid" aria-label="Tijdsblokken">
        @foreach (var block in _timeBlocks)
        {
            <TimeBlockCard @key="block.Id" 
                           Block="block" 
                           SelectedDate="_selectedDate"
                           OnAddActivity="trigger => OpenActivityForm(block.Id, trigger)"
                           OnOpenActivity="selection => OpenActivityDetailsAsync(selection.Activity.Id, selection.Trigger)"
                           OnToggleCompletion="ToggleActivityCompletionAsync"
                           CompletionUpdatesInProgress="_completionUpdatesInProgress"
                           CompletionErrorActivityId="_completionErrorActivityId" />
        }
    </div>
}
@if (_selectedActivityDetails is not null && !_isActivityFormOpen)
{
    <ActivityDetailsDialog Activity="_selectedActivityDetails"
                           OnClose="CloseActivityDetails"
                           OnEdit="OpenEditDialog" />
}
@if (_isActivityFormOpen)
{
    <ActivityForm InitialDate="@(_selectedActivityDetails?.Date ?? _selectedDate)"
                  InitialTimeBlockId="_initialTimeBlockId"
                  ExistingActivity="_selectedActivityDetails"
                  TimeBlocks="_timeBlocks"
                  OnSaved="ActivitySavedAsync"
                  OnDeleted="ActivityDeletedAsync"
                  OnClose="CancelActivityForm" />
}
