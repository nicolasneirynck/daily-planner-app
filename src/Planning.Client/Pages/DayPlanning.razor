@page "/dayplanning"
@using Planning.Client.DayPlanning

<PageTitle>Dagplanning</PageTitle>

<header class="day-planning-header">
    <p>Dagplanning</p> @* TODO -> Goedemorgen, Nicolas .. Goedeavond, Nicolas*@
    <h1 data-testid="selected-date">
        @FormatSelectedDate(_selectedDate)
    </h1>
    
    <div class="day-navigation-slot">
        <DateNavigation SelectedDate="_selectedDate"
                        DateSelected="SelectDateAsync" />
        
        @if (!_isLoading && !_hasLoadError)
        {
            <a class="global-add-activity mobile-activity-action"
               data-testid="mobile-global-add-activity-link"
               href="@NewActivityUrl"
               aria-label="Activiteit toevoegen">
                <span class="global-add-icon" aria-hidden="true">+</span>
                <span class="global-add-label">Activiteit toevoegen</span>
            </a>
            <button type="button"
                    class="global-add-activity desktop-activity-action"
                    data-testid="global-add-activity-button"
                    @ref="_globalAddButton"
                    aria-label="Activiteit toevoegen"
                    @onclick="() => OpenActivityForm(null, _globalAddButton)">
                <span class="global-add-icon" aria-hidden="true">+</span>
                <span class="global-add-label">Activiteit toevoegen</span>
            </button>
        }
    </div>
    
    
</header>

@if (_isLoading)
{
    <p>Dagplanning laden...</p>
}
else if (_hasLoadError)
{
    <p role="alert">De dagplanning kon niet geladen worden.</p>
}
else
{
    @if (_activityError is not null)
    {
        <p role="alert">@_activityError</p>
    }

    <div class="time-block-grid" aria-label="Tijdsblokken">
        @foreach (var block in _timeBlocks)
        {
            <TimeBlockCard @key="block.Id" 
                           Block="block" 
                           SelectedDate="_selectedDate"
                           OnAddActivity="trigger => OpenActivityForm(block.Id, trigger)"
                           OnOpenActivity="selection => OpenExistingActivity(selection.Activity.Id, selection.Trigger)"
                           OnToggleCompletion="ToggleActivityCompletionAsync"
                           CompletionUpdatesInProgress="_completionUpdatesInProgress"
                           CompletionErrorActivityId="_completionErrorActivityId" />
        }
    </div>
}
@if (_isActivityDetailsOpen && _selectedActivity is not null &&
     _selectedActivityDate is not null && _selectedTimeBlockName is not null)
{
    <ActivityDetailsDialog Activity="_selectedActivity"
                           Date="_selectedActivityDate.Value"
                           TimeBlockName="@_selectedTimeBlockName"
                           CompletionError="@(_completionErrorActivityId == _selectedActivity.Id)"
                           CompletionUpdating="@_completionUpdatesInProgress.Contains(_selectedActivity.Id)"
                           OnClose="CloseActivityDetails"
                           OnEdit="EditSelectedActivity"
                           OnDelete="ShowDeleteConfirmation"
                           OnToggleCompletion="ToggleActivityCompletionAsync" />
}
@if (_showDeleteConfirmation && _selectedActivity is not null)
{
    <ConfirmationDialog Title="Verwijderen uit planning?"
                        Message="@DeleteConfirmationMessage"
                        CancelText="@(SelectedActivityDeleting ? "Sluiten" : "Annuleren")"
                        ConfirmText="@(SelectedActivityDeleting ? "Verwijderen..." : "Verwijderen")"
                        CancelTestId="cancel-delete-button"
                        ConfirmTestId="confirm-delete-button"
                        ConfirmDisabled="SelectedActivityDeleting"
                        OnCancel="CancelDeleteConfirmation"
                        OnConfirm="DeleteSelectedActivityAsync">
        @if (_deleteError is not null)
        {
            <p role="alert" data-testid="activity-delete-error">@_deleteError</p>
        }
    </ConfirmationDialog>
}
@if (_isActivityFormOpen)
{
    var activityOpenVersion = _activityOpenVersion;
    <ActivityForm InitialDate="_selectedActivityDate ?? _selectedDate"
                  InitialTimeBlockId="_initialTimeBlockId"
                  ExistingActivity="_selectedActivity"
                  TimeBlocks="_timeBlocks"
                  OnSaved="date => ActivitySavedAsync(date, activityOpenVersion)"
                  OnDeleted="ApplyDeletedActivity"
                  OnClose="CancelActivityForm" />
}
