@page "/dayplanning"
@using Planning.Client.DayPlanning

<PageTitle>Dagplanning</PageTitle>

<header class="day-planning-header">
    <p>Dagplanning</p> @* TODO -> Goedemorgen, Nicolas .. Goedeavond, Nicolas*@
    <h1 data-testid="selected-date">
        @FormatSelectedDate(_selectedDate)
    </h1>
    
    <div class="day-navigation-slot">
        <DateNavigation SelectedDate="_selectedDate"
                        DateSelected="LoadDayAsync" />
    </div>
    
    
</header>

@if (_isLoading)
{
    <p>Dagplanning laden...</p>
}
else if (_hasLoadError)
{
    <p>De dagplanning kon niet geladen worden.</p>
}
else
{
    <div class="time-block-grid" aria-label="Tijdsblokken">
        @foreach (var block in _timeBlocks)
        {
            <TimeBlockCard @key="block.Id" 
                           Block="block" 
                           OnAddActivity="() => OpenActivityForm(block.Id)" />
        }
    </div>
}
@if (_isActivityFormOpen)
{
    <AddActivityForm InitialDate="_selectedDate"
                     InitialTimeBlockId="_initialTimeBlockId"
                     TimeBlocks="_timeBlocks"
                     OnClose="CloseActivityForm" />
}
