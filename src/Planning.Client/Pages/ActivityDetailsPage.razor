@page "/dayplanning/activities/{ActivityId:int}"
@layout ActivityFormLayout
@using Planning.Client.DayPlanning

<PageTitle>Activiteit bekijken</PageTitle>

@if (_isLoading)
{
    <p>Activiteit laden...</p>
}
else if (_loadError is not null)
{
    <p role="alert">@_loadError</p>
}
else if (_details is not null)
{
    <section aria-label="Activiteit bekijken">
        <header class="activity-details-header">
            <button type="button"
                    aria-label="Terug naar dagplanning"
                    @onclick="ReturnToDay">
                Terug
            </button>
            <h1>Activiteit bekijken</h1>
            <button type="button"
                    aria-label="Bewerken"
                    @onclick="OpenEdit">
                <img src="/icons/lucide/pencil.svg"
                     alt=""
                     width="24"
                     height="24" />
            </button>
        </header>
        <PlannedActivityDetails Activity="_details" />
    </section>
}
