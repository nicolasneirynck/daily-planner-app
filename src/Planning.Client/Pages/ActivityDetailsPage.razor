@page "/dayplanning/activities/{ActivityId:int}"
@layout ActivityFormLayout
@using Planning.Client.DayPlanning

<PageTitle>Activiteit bekijken</PageTitle>

@if (_isLoading)
{
    <p>Activiteit laden...</p>
}
else if (_loadError is not null)
{
    <p role="alert">@_loadError</p>
}
else if (_details is not null)
{
    <section class="activity-details-page" aria-label="Activiteit bekijken">
        <header class="activity-details-header">
            <button type="button"
                    aria-label="Terug naar dagplanning"
                    @onclick="ReturnToDay">
                <span class="lucide-icon icon-arrow-left" aria-hidden="true"></span>
            </button>

            <h1 tabindex="-1" @ref="_pageTitle">Activiteit bekijken</h1>

            <button type="button"
                    aria-label="Bewerken"
                    @onclick="OpenEdit">
                <span class="lucide-icon icon-pencil" aria-hidden="true"></span>
            </button>
        </header>
        <PlannedActivityDetails Activity="_details"
                                OnToggleCompletion="ToggleCompletionAsync"
                                CompletionUpdating="_isUpdatingCompletion"
                                CompletionError="_completionError"
                                OnDelete="ShowDeleteConfirmation" />
    </section>

    @if (_showDeleteConfirmation)
    {
        <ConfirmationDialog Title="Verwijderen uit planning?"
                            Message="@DeleteConfirmationMessage"
                            CancelText="Annuleren"
                            ConfirmText="@(_isDeleting ? "Verwijderen..." : "Verwijderen")"
                            CancelTestId="cancel-delete-button"
                            ConfirmTestId="confirm-delete-button"
                            ConfirmDisabled="_isDeleting"
                            OnCancel="CancelDeleteConfirmation"
                            OnConfirm="DeleteAsync">
            @if (_deleteError is not null)
            {
                <p role="alert">@_deleteError</p>
            }
        </ConfirmationDialog>
    }
}
