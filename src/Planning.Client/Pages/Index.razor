@page "/"
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<p>Doorsturen...</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var destination = state.User.Identity?.IsAuthenticated == true
            ? "/dayplanning"
            : "/login?returnUrl=%2Fdayplanning";

        Navigation.NavigateTo(destination, replace: true); 
        /* "replace: true" -> vervang de huidige pagina in de geschiedenis van de browser.
         
         Bij het openen van de app op / sturen we meteen door naar /dayplanning. 
         Zonder "replace: true" onthoudt de browser beide stappen: "/ → /dayplanning"
         
         Als je dan op Terug klikt, kom je weer op /, die je onmiddellijk opnieuw doorstuurt. 
         Met replace: true wordt die tijdelijke /-stap vervangen door /dayplanning, 
         zodat Terug naar de pagina gaat waar je vóór de app was.
         */
    }
}