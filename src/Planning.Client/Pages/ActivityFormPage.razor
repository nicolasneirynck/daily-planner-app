@page "/dayplanning/activities/new"
@page "/dayplanning/activities/{ActivityId:int}/edit"
@layout ActivityFormLayout
@using Planning.Client.DayPlanning

<PageTitle>@(ActivityId is null ? "Activiteit toevoegen" : "Activiteit aanpassen")</PageTitle>

@if (_isLoading)
{
    <p class="activity-form-page-state">Dagplanning laden...</p>
}
else if (_loadError is not null)
{
    <div class="activity-form-page-state">
        <p role="alert">@_loadError</p>
        <a href="@DayUrl(_date)">Terug naar dagplanning</a>
    </div>
}
else
{
    <ActivityForm @key="FormKey"
                  Presentation="ActivityFormPresentation.Page"
                  InitialDate="_date"
                  InitialTimeBlockId="_initialTimeBlockId"
                  ExistingActivity="_activity"
                  TimeBlocks="_timeBlocks"
                  OnSaved="ReturnToDay"
                  OnDeleted="ReturnToDay"
                  OnClose="ReturnToOriginalDay" />
}
