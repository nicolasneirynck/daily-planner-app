@page "/logout"

<PageTitle>Logout</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (_logoutError is not null)
        {
            <div class="alert alert-danger">@_logoutError</div>
        }
        else
        {
            <div class="alert alert-info">Logging you out...</div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-success">You're logged out. <a href="/login">Log in.</a></div>
    </NotAuthorized>
</AuthorizeView>
