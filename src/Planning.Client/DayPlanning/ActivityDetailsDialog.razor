@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using Planning.Shared.DayPlanning
@inject IJSRuntime Js

<dialog @ref="_dialog"
        class="activity-details-dialog"
        aria-label="Activiteit bekijken"
        aria-modal="true"
        @onclose="OnClose">
    <header class="activity-details-dialog-header">
        <h2>Activiteit bekijken</h2>
        <div class="activity-details-dialog-controls">
            <button type="button" aria-label="Bewerken" @onclick="OnEdit">
                <span class="lucide-icon icon-pencil" aria-hidden="true"></span>
            </button>
            <button type="button" aria-label="Sluiten" @onclick="OnClose">
                <span class="lucide-icon icon-x" aria-hidden="true"></span>
            </button>
        </div>
    </header>

    <PlannedActivityDetails Activity="Activity"
                            OnToggleCompletion="OnToggleCompletion"
                            CompletionUpdating="CompletionUpdating"
                            CompletionError="CompletionError"
                            OnDelete="OnDelete" />
</dialog>

@code {
    [Parameter, EditorRequired]
    public PlannedActivityDetailsDto Activity { get; set; } = default!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnEdit { get; set; }

    [Parameter]
    public EventCallback OnToggleCompletion { get; set; }

    [Parameter]
    public bool CompletionUpdating { get; set; }

    [Parameter]
    public bool CompletionError { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }

    private ElementReference _dialog;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await Js.InvokeAsync<IJSObjectReference>(
            "import", "./js/activityDialog.js");
        await _module.InvokeVoidAsync("showModal", _dialog);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
            await _module.DisposeAsync();
    }
}
