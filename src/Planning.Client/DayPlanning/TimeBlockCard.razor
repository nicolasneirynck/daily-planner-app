@using Microsoft.AspNetCore.Components
@using Planning.Shared.DayPlanning

<section class="time-block time-block-@Block.SortOrder"
         aria-labelledby="time-block-@Block.Id"
         data-testid="time-block-@Block.Id">
    <h2 id="time-block-@Block.Id" data-testid="time-block-name">@Block.Name</h2>
    <p class="time-block-hours">
        @Block.StartTime.ToString("HH:mm") - @Block.EndTime.ToString("HH:mm")
    </p>

    <div class="@(Block.Activities.Count == 0 ? "time-block-content-empty" : "")">
        @if (Block.Activities.Count == 0)
        {
            <p class="time-block-empty">Niets gepland!</p>
        }
        else
        {
            <ul class="planned-activity-list">
                @foreach (var activity in Block.Activities)
                {
                    <li @key="activity.Id"
                        class="@(activity.IsCompleted ? "is-completed" : "")"
                        data-testid="planned-activity-row">
                        <button type="button"
                                class="activity-completion-toggle"
                                data-testid="activity-completion-toggle"
                                aria-label="@(activity.IsCompleted
                                                ? $"Markeer {activity.Name} als niet voltooid"
                                                : $"Markeer {activity.Name} als voltooid")"
                                aria-pressed="@(activity.IsCompleted ? "true" : "false")"
                                disabled="@CompletionUpdatesInProgress.Contains(activity.Id)"
                                @onclick="() => OnToggleCompletion.InvokeAsync(activity)">
                            @if (activity.IsCompleted)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M20 6 9 17l-5-5" />
                                </svg>
                            }
                        </button>

                        <span class="planned-activity-name" data-testid="planned-activity-name">
                            @activity.Name
                        </span>

                        @if (CompletionErrorActivityId == activity.Id)
                        {
                            <p class="completion-error" role="alert">
                                Status wijzigen is niet gelukt. Probeer het opnieuw.
                            </p>
                        }
                    </li>
                }
            </ul>
        }
        
        <button type="button"
                class="time-block-add-activity"
                data-testid="add-activity-button"
                @ref="_addActivityButton"
                aria-label="Activiteit toevoegen aan @Block.Name"
                @onclick="() => OnAddActivity.InvokeAsync(_addActivityButton)">
            <span class="time-block-add-icon">+</span>
            @if (Block.Activities.Count > 0)
            {
                <span>Activiteit</span>
            }
        </button>
    </div>
</section>

@code {
    private ElementReference _addActivityButton;

    [Parameter, EditorRequired]
    public TimeBlockDto Block { get; set; } = default!;
    
    [Parameter, EditorRequired]
    public EventCallback<PlannedActivityDto> OnToggleCompletion { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ElementReference> OnAddActivity { get; set; }

    [Parameter]
    public IReadOnlySet<int> CompletionUpdatesInProgress { get; set; }
        = new HashSet<int>();

    [Parameter]
    public int? CompletionErrorActivityId { get; set; }
}
