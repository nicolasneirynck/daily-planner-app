<section class="planned-activity-details @(IsPage ? "activity-details-page" : null)"
         aria-label="Activiteit bekijken">
    <header class="activity-details-header">
        <button type="button"
                class="activity-details-close"
                aria-label="@(IsPage ? "Terug" : "Sluiten")"
                @onclick="OnClose">
            <span class="activity-detail-icon @(IsPage ? "icon-arrow-left" : "icon-x")"
                  aria-hidden="true"></span>
        </button>
        <h1>Activiteit bekijken</h1>
        <button type="button"
                class="activity-details-edit"
                data-testid="activity-detail-edit-button"
                aria-label="Bewerken"
                @onclick="OnEdit">
            <span class="activity-detail-icon icon-pencil" aria-hidden="true"></span>
        </button>
    </header>

    <div class="activity-details-content">
        <div class="activity-details-card">
            <h2 data-testid="activity-detail-name">@Activity.Name</h2>

            @if (Activity.IsImportant)
            {
                <p class="activity-detail-row activity-detail-importance"
                   data-testid="activity-detail-importance">
                    <span class="activity-detail-icon icon-flag" aria-hidden="true"></span>
                    <span>Belangrijk</span>
                </p>
            }

            <p class="activity-detail-row" data-testid="activity-detail-date">
                <span class="activity-detail-icon icon-calendar-days"
                      role="img" aria-label="Datum"></span>
                <span>@DateLabel</span>
            </p>
            <p class="activity-detail-row" data-testid="activity-detail-time-block">
                <span class="activity-detail-icon icon-clock-3"
                      role="img" aria-label="Tijdsblok"></span>
                <span>@TimeBlockName</span>
            </p>

            @if (!string.IsNullOrWhiteSpace(Activity.Description))
            {
                <section class="activity-details-description">
                    <h3>Beschrijving</h3>
                    <p data-testid="activity-detail-description">
                        @Activity.Description
                    </p>
                </section>
            }
        </div>
    </div>

    <footer class="activity-details-actions">
        @if (CompletionError)
        {
            <p role="alert">Status wijzigen is niet gelukt. Probeer het opnieuw.</p>
        }

        @if (DeleteError is not null)
        {
            <p role="alert">@DeleteError</p>
        }

        <button type="button"
                class="activity-detail-completion-button"
                data-testid="activity-detail-completion-toggle"
                aria-pressed="@(Activity.IsCompleted ? "true" : "false")"
                disabled="@CompletionUpdating"
                @onclick="() => OnToggleCompletion.InvokeAsync(Activity)">
            <span class="activity-completion-icon" aria-hidden="true">
                <span class="activity-detail-icon @(Activity.IsCompleted ? "icon-check" : "icon-circle-check")"></span>
            </span>
            <span>@(Activity.IsCompleted ? "Activiteit voltooid" : "Activiteit voltooien")</span>
        </button>

        <button type="button"
                class="activity-detail-delete-button"
                data-testid="activity-detail-delete-button"
                @onclick="OnDelete">
            <span class="activity-detail-icon icon-trash" aria-hidden="true"></span>
            <span>Verwijderen uit planning</span>
        </button>
    </footer>
</section>
