@*  De code lijn onder commentaar is Razor-syntaxis om een stuk HTML in een variabele te bewaren:

    RenderFragment is een type voor herbruikbare Razor-opmaak
    @<div> ... </div> maakt die opmaak aan
    formContent is de variabele. Verderop toont @formContent de inhoud op die plek.
    
    Zo kun je dezelfde formuliervelden in een paginacontainer of een modal plaatsen 
    zonder de veldopmaak twee keer te schrijven
*@
@{
    RenderFragment formContent = @<div class="activity-form-content"> 
    <header>
        @if (Presentation == ActivityFormPresentation.Page)
        {
            <h1 id="activity-form-title">
                @(ExistingActivity is null ? "Activiteit toevoegen" : "Activiteit aanpassen")
            </h1>
        }
        else
        {
            <h2 id="activity-form-title">
                @(ExistingActivity is null ? "Activiteit toevoegen" : "Activiteit aanpassen")
            </h2>
        }
        <button type="button"
                @ref="_closeButton"
                aria-label="@(Presentation == ActivityFormPresentation.Page ? "Terug" : "Sluiten")"
                @onclick="RequestCloseAsync">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                @if (Presentation == ActivityFormPresentation.Page)
                {
                    <path d="M19 12H5m7-7-7 7 7 7" /> // "vorig" pijltje
                }
                else
                {
                    <path d="M18 6 6 18M6 6l12 12" /> // "sluit" kruisje
                }
            </svg>
        </button>
    </header>

    @*
        <EditForm EditContext="_editContext"> gebruikt de EditContext van ons formuliermodel.
        <DataAnnotationsValidator /> laat Blazor de validatieattributen op dat model gebruiken, zoals [VisibleText], [StringLength] en [Required].

        Een EditContext houdt de toestand van het formulier bij: welk model erbij hoort, welke velden gewijzigd zijn en welke validatiefouten er zijn.
        Met EditContext="_editContext" geven we EditForm die toestand expliciet mee, zodat de code-behind de veldfouten kan opvragen en bijwerken.
    *@
    <EditForm EditContext="_editContext"
              OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    @{ var nameErrors = _editContext.GetValidationMessages(_nameField).ToArray(); }
    <label for="activity-name">Naam *</label>
    <input id="activity-name"
           type="text"
           data-testid="activity-name"
           @ref="_nameInput"
           aria-invalid="@(nameErrors.Length > 0 ? "true" : "false")"
           aria-describedby="@(nameErrors.Length > 0 ? "activity-name-error" : null)"
           placeholder="Bv. Ochtendwandeling"
           @bind="_model.Name"
           @oninput="HandleNameInput" />

    @if (nameErrors.Length > 0)
    {
        <div id="activity-name-error" role="alert">
            @foreach (var error in nameErrors)
            {
                <p>@error</p>
            }
        </div>
    }

    @* haalt huidige validatiefouten op*@
    @{ var descriptionErrors = _editContext.GetValidationMessages(_descriptionField).ToArray(); }
    <label for="activity-description">Beschrijving (optioneel)</label>
    <textarea id="activity-description"
              data-testid="activity-description"
              maxlength="500"
              aria-invalid="@(descriptionErrors.Length > 0 ? "true" : "false")"
              aria-describedby="@(descriptionErrors.Length > 0
                  ? "activity-description-count activity-description-error"
                  : "activity-description-count")"
              @bind="_model.Description"
              @oninput="HandleDescriptionInput"></textarea>

    <div class="activity-description-meta">
        @if (_model.Description?.Length == 500)
        {
            <p role="status"
               class="activity-description-limit"
               data-testid="activity-description-limit">
                Maximum van 500 tekens bereikt.
            </p>
        }

        <p id="activity-description-count"
           class="activity-description-count"
           data-testid="activity-description-count">
            @(_model.Description?.Length ?? 0)/500
        </p>
    </div>

    @if (descriptionErrors.Length > 0)
    {
        <div id="activity-description-error" role="alert">
            @foreach (var error in descriptionErrors)
            {
                <p>@error</p>
            }
        </div>
    }

    <label for="activity-date">Datum *</label>
    <input id="activity-date"
           type="date"
           data-testid="activity-date"
           @bind="_model.Date"
           @bind:format="yyyy-MM-dd"/>

    <label for="activity-time-block">Tijdsblok *</label>
    @{ var timeBlockErrors = _editContext.GetValidationMessages(_timeBlockField).ToArray(); }
    <div class="activity-form-select">
        <select id="activity-time-block"
                data-testid="activity-time-block"
                aria-invalid="@(timeBlockErrors.Length > 0 ? "true" : "false")"
                aria-describedby="@(timeBlockErrors.Length > 0 ? "activity-time-block-error" : null)"
                @bind="_model.TimeBlockId"
                @bind:after="HandleTimeBlockChange" > @* @bind:after voert een methode uit nadat @bind de nieuwe waarde heeft opgeslagen. *@
            <option value="">Kies een tijdsblok</option>
            @foreach (var block in TimeBlocks)
            {
                <option value="@block.Id">@block.Name</option>
            }
        </select>

        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m6 9 6 6 6-6" />
        </svg>
    </div>

    @if (timeBlockErrors.Length > 0)
    {
        <div id="activity-time-block-error"
             data-testid="activity-time-block-error"
             role="alert">
            @foreach (var error in timeBlockErrors)
            {
                <p>@error</p>
            }
        </div>
    }

    <label class="activity-important-toggle" for="activity-important">
        <input id="activity-important"
               type="checkbox"
               data-testid="activity-important"
               @bind="_model.IsImportant" />

        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 22V4a1 1 0 0 1 .4-.8A6 6 0 0 1 8 2c3 0 5 2 7.333 2q2 0 3.067-.8A1 1 0 0 1 20 4v10a1 1 0 0 1-.4.8A6 6 0 0 1 16 16c-3 0-5-2-8-2a6 6 0 0 0-4 1.528" />
        </svg>

        <span>Belangrijk</span>
    </label>

    @if (_saveError is not null)
    {
        <p role="alert" data-testid="activity-save-error">@_saveError</p>
    }

    @if (ExistingActivity is null)
    {
        <button type="submit"
                class="activity-form-submit"
                data-testid="submit-activity-button"
                disabled="@_isSaving">
            @(_isSaving ? "Opslaan..." : "Activiteit toevoegen")
        </button>
    }

    @if (ExistingActivity is not null)
    {
        <button type="submit"
                class="activity-form-submit"
                data-testid="update-activity-button"
                disabled="@(!HasUnsavedChanges || _isSaving)">
            @(_isSaving ? "Opslaan..." : "Wijzigingen opslaan")
        </button>

        <button type="button"
                class="activity-delete-trigger"
                data-testid="delete-activity-button"
                @ref="_deleteButton"
                @onclick="ShowDeleteConfirmation" >
            <svg aria-hidden="true" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M3 6h18" />
                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
            </svg>
            <span>Verwijderen uit planning</span>
        </button>
    }
    </EditForm>
    </div>;
}

@if (Presentation == ActivityFormPresentation.Page)
{
    /* NavigationLock is een Blazor-component die navigatie kan onderscheppen zolang het formulier op de pagina staat.
     * Het doel hier is voorkomen dat je per ongeluk niet-opgeslagen wijzigingen verliest.
     *
     * Er zijn 2 soorten navigatie:
     * - Binnen de app, bijvoorbeeld de terugknop van de browser naar de dagplanning: BeforePageNavigationAsync wordt aangeroepen. Die methode moet zelf beslissen of de navigatie doorgaat of met context.PreventNavigation() wordt tegengehouden.
     * - Buiten de app of bij verversen/sluiten van het tabblad: ConfirmExternalNavigation laat de browser een standaardwaarschuwing tonen als HasChangedFormValues waar is en _allowNavigation onwaar is.
     */
    <NavigationLock OnBeforeInternalNavigation="BeforePageNavigationAsync"
                    ConfirmExternalNavigation="@(HasChangedFormValues && !_allowNavigation)" />
    
    <section class="activity-form activity-form-page"
             data-testid="activity-form-page"
             aria-labelledby="activity-form-title">
        @formContent
    </section>
}
else
{
    <dialog @ref="_activityDialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="activity-form-title"
            class="activity-form activity-form-modal"
            @onclose="OnClose">
        @formContent
    </dialog>
}

@if (_isAwaitingCloseConfirmation)
{
    <ConfirmationDialog Title="Niet-opgeslagen wijzigingen?"
                        Message="Je wijzigingen gaan verloren als je dit formulier sluit."
                        CancelText="Verder bewerken"
                        ConfirmText="Sluiten zonder opslaan"
                        CancelTestId="continue-editing-button"
                        ConfirmTestId="discard-changes-button"
                        OnCancel="ContinueEditing"
                        OnConfirm="DiscardChangesAsync" />
}

@if (_isAwaitingDeleteConfirmation)
{
    <ConfirmationDialog Title="Verwijderen uit planning?"
                        Message="@DeleteConfirmationMessage"
                        CancelText="Annuleren"
                        ConfirmText="Verwijderen"
                        CancelTestId="cancel-delete-button"
                        ConfirmTestId="confirm-delete-button"
                        ConfirmDisabled="@_isDeleting"
                        OnCancel="CancelDeleteConfirmation"
                        OnConfirm="DeleteAsync">
        @if (_deleteError is not null)
        {
            <p role="alert" data-testid="activity-delete-error">@_deleteError</p>
        }
    </ConfirmationDialog>
}
