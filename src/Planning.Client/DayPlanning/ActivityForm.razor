<dialog @ref="_activityDialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="activity-form-title"
        class="activity-form"
        @onclose="OnClose">
    <header>
        <h2 id="activity-form-title">
            @(ExistingActivity is null ? "Activiteit toevoegen" : "Activiteit bekijken")
        </h2>
        <button type="button"
                @ref="_closeButton"
                aria-label="Sluiten"
                @onclick="OnClose">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M18 6 6 18M6 6l12 12" />
            </svg>
        </button>
    </header>

    <label for="activity-name">Naam *</label>
    <input id="activity-name"
           type="text"
           data-testid="activity-name"
           @ref="_nameInput"
           readonly="@(ExistingActivity is not null)"
           aria-invalid="@(_nameError is not null ? "true" : "false")"
           aria-describedby="@(_nameError is not null ? "activity-name-error" : null)"
           placeholder="Bv. Ochtendwandeling"
           @bind="_name"
           @oninput="HandleNameInput" />

    @if (_nameError is not null)
    {
        <p id="activity-name-error" role="alert">@_nameError</p>
    }

    <label for="activity-date">Datum *</label>
    <input id="activity-date"
           type="date"
           disabled="@(ExistingActivity is not null)"
           data-testid="activity-date"
           @bind="_date"
           @bind:format="yyyy-MM-dd"/>

    <label for="activity-time-block">Tijdsblok *</label>
    <div class="activity-form-select">
        <select id="activity-time-block"
                data-testid="activity-time-block"
                disabled="@(ExistingActivity is not null)"
                aria-invalid="@(_timeBlockError is not null ? "true" : "false")"
                aria-describedby="@(_timeBlockError is not null ? "activity-time-block-error" : null)"
                @bind="_timeBlockId"
                @bind:after="HandleTimeBlockChange" > @* @bind:after voert een methode uit nadat @bind de nieuwe waarde heeft opgeslagen. *@
            <option value="">Kies een tijdsblok</option>
            @foreach (var block in TimeBlocks)
            {
                <option value="@block.Id">@block.Name</option>
            }
        </select>

        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m6 9 6 6 6-6" />
        </svg>
    </div>

    @if (_timeBlockError is not null)
    {
        <p id="activity-time-block-error"
           data-testid="activity-time-block-error"
           role="alert">@_timeBlockError</p>
    }

    @if (SaveError is not null)
    {
        <p role="alert" data-testid="activity-save-error">@SaveError</p>
    }

    @if (ExistingActivity is null)
    {
        <button type="button"
                class="activity-form-submit"
                data-testid="submit-activity-button"
                @onclick="SubmitAsync">
            Activiteit toevoegen
        </button>
    }

    @if (ExistingActivity is not null)
    {
        <button type="button"
                class="activity-delete-trigger"
                data-testid="delete-activity-button"
                @ref="_deleteButton"
                @onclick="ShowDeleteConfirmation" >
            <svg aria-hidden="true" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M3 6h18" />
                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
            </svg>
            <span>Verwijderen uit planning</span>
        </button>
    }
</dialog>

@if (_isConfirmingDeletion)
{
    <dialog class="delete-confirmation"
            role="alertdialog"
            aria-modal="true"
            aria-labelledby="delete-title"
            aria-describedby="delete-question"
            @ref="_confirmationDialog"
            @onclose="CancelDeleteConfirmation">

        <h2 id="delete-title">Verwijderen uit planning?</h2>

        <p id="delete-question">
            @($"“{ExistingActivity!.Name}” wordt verwijderd uit je dagplanning.")
        </p>

        @if (DeleteError is not null)
        {
            <p role="alert" data-testid="activity-delete-error">@DeleteError</p>
        }

        <div class="delete-confirmation-actions">
            <button type="button"
                    class="delete-confirmation-cancel"
                    data-testid="cancel-delete-button"
                    @onclick="CancelDeleteConfirmation">
                Annuleren
            </button>

            <button type="button"
                    class="delete-confirmation-confirm"
                    data-testid="confirm-delete-button"
                    disabled="@IsDeleting"
                    @onclick="() => OnConfirmDelete.InvokeAsync(ExistingActivity!.Id)">
                Verwijderen
            </button>
        </div>
    </dialog>
}
